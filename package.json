{
  "name": "zhiyin-api-tutorial",
  "version": "0.8.0",
  "private": true,
  "description": "只因 API 新手教程：对话、图片、视频、Agent 与账户费用",
  "scripts": {
    "start": "node serve-preview.mjs",
    "check": "node scripts/validate-pages.cjs && npm run test:configure",
    "test:configure": "node --test tests/configure.test.mjs",
    "build:configure": "node scripts/build-configure.mjs",
    "prepare:release": "npm run build:configure && node scripts/version-assets.cjs && npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  }
}
